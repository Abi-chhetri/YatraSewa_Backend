generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  role_id   String @id @default(uuid()) @db.Uuid
  role_name String @unique @db.VarChar(50)

  role_permissions RolePermission[]
  users            User[]
}

model Permission {
  permission_id   String  @id @default(uuid()) @db.Uuid
  permission_name String  @unique @db.VarChar(100)
  description     String? @db.Text

  role_permissions RolePermission[]
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [role_id])
  permission Permission @relation(fields: [permission_id], references: [permission_id])

  @@id([role_id, permission_id])
}

model User {
  user_id           String    @id @default(uuid()) @db.Uuid
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  email             String    @unique @db.VarChar(255)
  phone             String    @unique @db.VarChar(20)
  password_hash     String    @db.Text
  role_id           String    @db.Uuid
  status            String    @db.VarChar(20)
  email_verified_at DateTime? @db.Timestamptz
  phone_verified_at DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @db.Timestamptz

  role                Role                @relation(fields: [role_id], references: [role_id])
  sessions            Session[]
  password_resets     PasswordReset[]
  email_verifications EmailVerification[]
  company_memberships CompanyUser[]
  company_approvals   CompanyApproval[]   @relation("CompanyApprovalReviewer")
}

model Session {
  session_id         String    @id @default(uuid()) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @db.Text
  expires_at         DateTime  @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [user_id])
}

model PasswordReset {
  reset_id   String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.Text
  expires_at DateTime @db.Timestamptz
  is_used    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [user_id])
}

model EmailVerification {
  verification_id String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  token_hash      String   @db.Text
  expires_at      DateTime @db.Timestamptz
  is_verified     Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [user_id])
}

model Company {
  company_id          String    @id @default(uuid()) @db.Uuid
  company_name        String    @db.VarChar(150)
  email               String    @unique @db.VarChar(255)
  phone               String    @unique @db.VarChar(20)
  address             String    @db.Text
  registration_number String    @unique @db.VarChar(100)
  status              String    @db.VarChar(20)
  approved_at         DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @db.Timestamptz

  company_users     CompanyUser[]
  company_documents CompanyDocument[]
  company_approvals CompanyApproval[]
}

model CompanyUser {
  company_user_id String    @id @default(uuid()) @db.Uuid
  company_id      String    @db.Uuid
  user_id         String    @db.Uuid
  status          String    @db.VarChar(20)
  joined_at       DateTime  @default(now()) @db.Timestamptz
  left_at         DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @db.Timestamptz

  company Company @relation(fields: [company_id], references: [company_id])
  user    User    @relation(fields: [user_id], references: [user_id])
}

model CompanyDocument {
  document_id     String    @id @default(uuid()) @db.Uuid
  company_id      String    @db.Uuid
  document_type   String    @db.VarChar(50)
  document_number String?   @db.VarChar(100)
  document_url    String    @db.Text
  status          String    @db.VarChar(20)
  verified_at     DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @db.Timestamptz

  company Company @relation(fields: [company_id], references: [company_id])
}

model CompanyApproval {
  approval_id String   @id @default(uuid()) @db.Uuid
  company_id  String   @db.Uuid
  reviewed_by String   @db.Uuid
  decision    String   @db.VarChar(20)
  reason      String?  @db.Text
  reviewed_at DateTime @default(now()) @db.Timestamptz

  company  Company @relation(fields: [company_id], references: [company_id])
  reviewer User    @relation("CompanyApprovalReviewer", fields: [reviewed_by], references: [user_id])
}

model Vehicle {
  vehicle_id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_type              String   @db.VarChar(20)
  vehicle_manufactured_year Int
  vehicle_manufacturer      String   @db.VarChar(100)
  vehicle_model             String   @db.VarChar(100)
  seat_capacity             Int
  vehicle_status            String   @db.VarChar(30)
}
